<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/padding_dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?android:attr/textColorPrimaryInverseDisableOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dia_package_name"/>
            <Spinner
                android:id="@+id/sp_packages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/span_ver"/>
            <TextView
                android:textColor="?android:attr/textColorPrimaryInverseDisableOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/span_ver"
                android:text="@string/dia_class_name"/>
            <Spinner
                android:id="@+id/sp_classes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/span_ver"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
